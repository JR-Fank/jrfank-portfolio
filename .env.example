# Development media mode. These three values are intentionally non-secret.
SITE_URL=http://localhost:3000
MEDIA_URL=/mock-media
NEXT_PUBLIC_MEDIA_BASE_URL=/mock-media
NEXT_PUBLIC_SITE_INDEXABLE=false

# Production values are configured in Cloudflare Pages, not committed here:
# SITE_URL=https://portfolio.example.com
# MEDIA_URL=https://media.example.com
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
#
# Upload credentials are never NEXT_PUBLIC_* values and are intentionally not
# listed as assignable .env placeholders. See docs/PRODUCTION_MEDIA_SETUP.md.
