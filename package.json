{
  "name": "editorial-photography-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate": "tsx scripts/validate-content.ts && npm run media:validate",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && next build",
    "check": "npm run typecheck && npm run build && npm run media:verify-client && npm run media:verify-repository",
    "media:prepare": "tsx scripts/media/prepare.ts",
    "media:validate": "tsx scripts/media/validate.ts",
    "media:publish": "tsx scripts/media/publish.ts",
    "media:video:plan": "tsx scripts/media/video.ts plan",
    "media:video:validate": "tsx scripts/media/video.ts validate",
    "media:verify-client": "tsx scripts/media/verify-client.ts",
    "media:verify-repository": "tsx scripts/media/verify-repository.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@splidejs/splide": "^4.1.4",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
