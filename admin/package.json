{
  "name": "@jrfank/online-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:bundle"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.131.2"
  }
}
