{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jrfank-online-admin-checkpoint-a-local-only",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ADMIN_ENVIRONMENT": "production",
    "ADMIN_AUTH_MODE": "access"
  },
  "secrets": {
    "required": [
      "TEAM_DOMAIN",
      "POLICY_AUD"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
